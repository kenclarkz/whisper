{
  "name": "whisper",
  "version": "1.0.0",
  "private": true,
  "description": "WHISPER — a mobile-first multiplayer horror party game. One shared screen, phones as private controllers, whispered secrets, and a hidden Whisperer.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server run start",
    "server:test": "npm --prefix server test",
    "play": "npm run build && npm --prefix server run start"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "0.452.0",
    "next": "^14.2.35",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3"
  }
}
